---
import { site } from '../data/site';
const year = new Date().getFullYear();
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/expertise/', label: 'Expertise' },
  { href: '/work/', label: 'Work' },
  { href: '/insights/', label: 'Insights' },
  { href: '/contact/', label: 'Contact' },
];
---
<footer class="site-footer">
  <div class="container inner">
    <div>
      <p class="name">{site.name}</p>
      <p class="tag">{site.positioning}</p>
    </div>
    <nav aria-label="Footer">
      <ul role="list" class="links">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <ul role="list" class="links">
      <li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      {site.email ? <li><a href={`mailto:${site.email}`}>{site.email}</a></li> : <li class="muted">Email: TODO</li>}
    </ul>
  </div>
  <div class="container copy">© {year} {site.name}. All rights reserved.</div>
</footer>

<style>
  .site-footer { background: var(--navy); color: var(--ivory); margin-top: var(--section); padding: 3.5rem 0 2rem; }
  .inner { display: grid; gap: 2rem; }
  @media (min-width: 768px) { .inner { grid-template-columns: 2fr 1fr 1fr; } }
  .name { font-family: var(--serif); font-size: 1.3rem; font-weight: 600; letter-spacing: 0.04em; }
  .tag { margin-top: 0.5rem; opacity: 0.8; max-width: 42ch; font-size: 0.95rem; }
  .links { display: flex; flex-direction: column; gap: 0.6rem; }
  .links a { text-decoration: none; opacity: 0.85; }
  .links a:hover { opacity: 1; text-decoration: underline; }
  .muted { opacity: 0.6; }
  .copy { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(247, 245, 240, 0.18); font-size: 0.85rem; opacity: 0.7; }
  :focus-visible { outline-color: var(--ivory); }
</style>
