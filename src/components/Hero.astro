---
import Button from './Button.astro';
---
<section class="hero">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">Strategy · Growth · Transformation</p>
      <h1>Marketing &amp; Business Growth Leader</h1>
      <p class="lede">Building resilient marketing engines that drive sustainable business growth.</p>
      <div class="flow">
        <p>I help organizations create strategic clarity, improve marketing effectiveness, and connect business priorities with disciplined execution.</p>
        <p>With 21+ years of experience across marketing, business development, operations, partnerships, and digital ecosystems, I bring a practical, business-oriented approach to growth.</p>
      </div>
      <div class="actions">
        <Button href="/expertise/">Explore my expertise <span aria-hidden="true">↗</span></Button>
        <Button href="/contact/" variant="secondary">Let's connect</Button>
      </div>
    </div>
    <figure class="portrait">
      <!-- TODO: replace public/images/portrait-placeholder.jpg with the professional portrait -->
      <img src="/images/portrait-placeholder.jpg" alt="Portrait of Prathiba G." width="640" height="800" fetchpriority="high" />
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 6.5rem) clamp(3rem, 6vw, 5rem); }
  .grid { display: grid; gap: 2.5rem; }
  .copy > * + * { margin-top: 1.5rem; }
  .copy h1 { margin-top: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .portrait { order: -1; }
  .portrait img {
    width: 100%; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: var(--radius); background: var(--stone);
  }
  @media (min-width: 900px) {
    .grid { grid-template-columns: 7fr 5fr; align-items: center; gap: clamp(2rem, 6vw, 5rem); }
    .portrait { order: 0; }
  }
</style>
