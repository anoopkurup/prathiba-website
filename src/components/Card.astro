---
interface Props {
  title: string;
  href?: string;
  number?: string;
  class?: string;
}
const { title, href, number, class: cls = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href} class:list={['card', { 'card--link': !!href }, cls]}>
  {number && <span class="num">{number}</span>}
  <h3>{title}</h3>
  <div class="body"><slot /></div>
  {href && <span class="more" aria-hidden="true">→</span>}
</Tag>

<style>
  .card {
    display: flex; flex-direction: column; gap: 0.75rem;
    background: var(--stone); border-radius: var(--radius); padding: 1.75rem;
    text-decoration: none; height: 100%;
    transition: transform var(--ease), box-shadow var(--ease);
  }
  .card--link:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(23, 43, 77, 0.1); }
  .body { color: var(--navy-soft); }
  .body :global(p) { max-width: none; }
  .more { margin-top: auto; padding-top: 0.5rem; font-weight: 600; }
</style>
