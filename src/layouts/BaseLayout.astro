---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  canonical: string; // path, e.g. "/about/"
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, canonical, ogImage = '/images/og-image.png', noindex = false } = Astro.props;
const base = (import.meta.env.SITE as string | undefined) ?? site.domain;
const canonicalUrl = new URL(canonical, base).href;
const ogUrl = new URL(ogImage, base).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <slot name="head" />

    <!-- Analytics slot: add a privacy-conscious script here when needed (e.g. Plausible / Fathom).
    <script defer data-domain="YOUR-DOMAIN-HERE" src="https://plausible.io/js/script.js"></script>
    -->
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
