---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { render } from 'astro:content';
import { site } from '../../data/site';
import { getInsights } from '../../data/content';

export async function getStaticPaths() {
  const insights = await getInsights();
  return insights.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const date = d.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={`${d.title} | ${site.name}`} description={d.description} canonical={`/insights/${entry.id}/`} noindex={!d.published}>
  <article class="container article">
    <header class="head">
      <p class="eyebrow">Insights{!d.published && ' · Draft'}</p>
      <h1>{d.title}</h1>
      <p class="meta"><time datetime={d.pubDate.toISOString()}>{date}</time> · For {d.audience} · By {site.name}</p>
    </header>
    <div class="prose"><Content /></div>
    <footer class="foot">
      <Button href="/insights/" variant="secondary">← All insights</Button>
    </footer>
  </article>
</BaseLayout>

<style>
  .article { padding-block: var(--section); }
  .head { max-width: var(--measure); margin-bottom: 3rem; }
  .head h1 { font-size: clamp(2.1rem, 1.5rem + 2.2vw, 3.4rem); }
  .meta { margin-top: 1.25rem; color: var(--navy-soft); font-size: 0.95rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--navy); }
  .prose { font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem); }
  .foot { margin-top: 4rem; }
</style>
